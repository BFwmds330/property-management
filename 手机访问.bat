@echo off
rem ==================================================
rem  物业管家（个人版）—— 手机/平板访问模式
rem  与「启动.bat」完全一样，只是额外对同一 WiFi 开放，
rem  供手机浏览器访问。请只在可信的网络下使用！
rem ==================================================
cd /d "%~dp0"
title 物业管家（个人版）· 手机访问模式
set "WUYE_LAN=1"
cls
echo  ┌────────────────────────────────────┐
echo  │    物业管家（个人版）手机访问模式      │
echo  └────────────────────────────────────┘
echo.
echo  [注意] 本模式会对同一 WiFi 内的所有设备开放系统，
echo  请只在可信的网络下使用；建议同时启用启动密码：
echo  关闭本窗口后，可在命令行执行  set WUYE_PIN=四个数字  再启动。
echo.
call "%~dp0启动.bat"
